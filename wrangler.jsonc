// Cloudflare settings. TEMPORARY PREVIEW on Saad's personal Cloudflare account (s-majbour.workers.dev), Oct 22 2026.
// Move to the chapter account (iise-aub.workers.dev or the domain) before launch; see DECISIONS.md.
// The same code runs as two Workers that share one database and one photo store:
//  - "www"   → the public site, https://www.iise-aub.workers.dev   (never serves /admin)
//  - "admin" → the editing panel, https://admin.iise-aub.workers.dev (whole Worker behind Cloudflare Access)
// Deploy the public site with `npm run deploy`, the panel with `npm run deploy:admin`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iise-aub-db",
      // TEMPORARY: database on Saad's personal account (preview). Replace when moving to the chapter account.
      "database_id": "1f390751-f80d-41a0-9f91-f76fa3f44d6c",
      "migrations_dir": "migrations"
    }
  ],
  // Photos are stored in the database for now (no card needed). To use R2 later, add:
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "iise-aub-media" }],
  "vars": {
    "APP_ROLE": "public",
    // "1" = hidden preview: search engines are asked not to index the site. Set to "0" on launch day.
    "NOINDEX": "1",
    // Cloudflare's published Turnstile TEST key (always passes). Replaced with the real key at setup.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "SITE_URL": "https://www.s-majbour.workers.dev",
    "ADMIN_URL": "https://admin.s-majbour.workers.dev",
    // Filled in at setup (Cloudflare Zero Trust → Access application for the admin Worker).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Emails that become cabinet admins on first sign-in (comma-separated). Set at setup.
    "BOOTSTRAP_ADMINS": ""
  },
  "env": {
    "admin": {
      "name": "admin",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "iise-aub-db",
          "database_id": "1f390751-f80d-41a0-9f91-f76fa3f44d6c",
          "migrations_dir": "migrations"
        }
      ],
      // Photos are stored in the database for now (no card needed). To use R2 later, add:
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "iise-aub-media" }],
      "vars": {
        "APP_ROLE": "admin",
        "NOINDEX": "1",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
        "SITE_URL": "https://www.s-majbour.workers.dev",
        "ADMIN_URL": "https://admin.s-majbour.workers.dev",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "BOOTSTRAP_ADMINS": "s.majbour@outlook.com"
      }
    }
  }
}
