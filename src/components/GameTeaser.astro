---
// "Weekly puzzle" teaser: invites people to play and shows last week's winner. Hidden when the puzzle is off.
import T from './T.astro';
import { pick, t, type Lang } from '../lib/i18n';
import { loadGameTeaser } from '../lib/game-db';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { enabled, text, lastWinner } = await loadGameTeaser();
const tx = (b: string) => pick(text[b], 'text', lang);
const arrow = lang === 'ar' ? '←' : '→';
---
{enabled && (
  <section class="wrap teaser-wrap" aria-labelledby="teaser-title">
    <div class="teaser">
      <div class="t-map" aria-hidden="true">
        <!-- A tiny Depot Drop city: river with a bridge, buildings, houses and three warehouses with their routes. -->
        <svg viewBox="0 0 120 120">
          <g stroke="rgb(255 255 255 / 0.1)" stroke-width="0.6">{[20, 40, 60, 80, 100].map((v) => <><line x1={v} y1="0" x2={v} y2="120" /><line x1="0" y1={v} x2="120" y2={v} /></>)}</g>
          <path d="M60 0h20v40h-20zM60 60h20v20h20v40h-20v-20h-20z" fill="#6ea3d6" opacity="0.85" />
          <rect x="60" y="40" width="20" height="20" fill="#a87c52" />
          <rect x="20" y="60" width="20" height="20" fill="#3c4a62" /><rect x="100" y="20" width="20" height="20" fill="#3c4a62" />
          <g fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="30,30 30,10 10,10" stroke="#fff" /><polyline points="30,30 50,30 50,50 70,50 90,50 90,70" stroke="#9cc3ee" />
            <polyline points="30,90 10,90 10,110" stroke="#f2b46b" /><polyline points="30,90 50,90 50,110" stroke="#f2b46b" />
          </g>
          {[[10, 10], [90, 70], [10, 110], [50, 110], [110, 70]].map(([x, y]) => <circle cx={x} cy={y} r="5" fill="#fff" />)}
          <rect x="23" y="23" width="14" height="14" rx="3" fill="#fff" />
          <rect x="83" y="43" width="14" height="14" rx="3" fill="#9cc3ee" />
          <rect x="23" y="83" width="14" height="14" rx="3" fill="#f2b46b" />
        </svg>
      </div>
      <div class="t-body">
        <p class="t-eyebrow"><T v={tx('eyebrow')} page={lang} /> · <T v={tx('title')} page={lang} /></p>
        <h2 id="teaser-title"><T v={tx('cta_title')} page={lang} /></h2>
        <T v={tx('cta_text')} page={lang} as="p" class="t-text" />
        <div class="t-actions">
          <a class="btn btn-light" href={`/${lang}/game`}>{t(lang, 'gPlay')} <span class="arrow" aria-hidden="true">{arrow}</span></a>
          {lastWinner && <p class="t-winner">🏆 {t(lang, 'gLastWinner')}: <strong dir="auto">{lastWinner.nickname}</strong> ({lastWinner.score} {t(lang, 'gPts')})</p>}
        </div>
      </div>
    </div>
  </section>
)}
<style>
  .teaser-wrap { padding-block: 40px; }
  .teaser {
    position: relative; overflow: hidden; display: grid; gap: 20px; align-items: center; color: #fff;
    border-radius: calc(var(--radius) + 6px); padding: 26px;
    background: radial-gradient(120% 140% at 0% 0%, var(--slate-600) 0%, var(--navy-800) 45%, var(--navy-950) 100%);
  }
  @media (min-width: 760px) { .teaser { grid-template-columns: 220px 1fr; padding: 32px 40px; gap: 36px; } }
  .t-map { width: min(100%, 220px); }
  .t-eyebrow { margin: 0 0 6px; color: var(--steel-300); font-weight: 600; font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; }
  :lang(ar) .t-eyebrow { letter-spacing: 0; text-transform: none; font-size: 1rem; }
  .teaser h2 { color: #fff; font-size: clamp(1.7rem, 4.6vw, 2.4rem); margin-bottom: 8px; }
  .t-text { color: var(--steel-200); margin-bottom: 18px; }
  .t-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .t-winner { margin: 0; color: var(--steel-200); }
  .t-winner strong { color: #fff; }
</style>
