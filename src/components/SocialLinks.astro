---
import { t, type Lang } from '../lib/i18n';
interface Props { settings: Record<string, string>; lang: Lang; variant?: 'light' | 'dark' }
const { settings, lang, variant = 'light' } = Astro.props;
const links = [
  { key: 'instagram_url', label: 'Instagram', icon: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm5.25-3a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z' },
  { key: 'tiktok_url', label: 'TikTok', icon: 'M16.6 2c.3 2.4 1.7 4 4.1 4.2v3.1a7.6 7.6 0 0 1-4-1.2v6.6c0 4.3-3.5 6.8-7 6.3-3.5-.5-5.6-3.6-5-7 .6-3.2 3.6-5 6.9-4.6v3.3c-1.6-.4-3.4.4-3.7 2-.3 1.5.7 2.9 2.2 3.1 1.6.2 3.3-.8 3.3-3V2h3.2Z' },
  { key: 'linkedin_url', label: 'LinkedIn', icon: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.8v1.6h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.6 4.77 6V21h-4v-5c0-1.2 0-2.75-1.7-2.75-1.7 0-1.95 1.3-1.95 2.66V21h-4V9.75Z' },
  { key: 'contact_email', label: 'Email', icon: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V17h16V7.4l-8 5.3-8-5.3ZM5.6 7 12 11.2 18.4 7H5.6Z' },
].filter((l) => settings[l.key]);
const href = (key: string) => (key === 'contact_email' ? `mailto:${settings[key]}` : settings[key]);
---
{links.length > 0 ? (
  <ul class:list={['social', variant]} aria-label={t(lang, 'followUs')}>
    {links.map((l) => (
      <li>
        <a href={href(l.key)} rel="noopener" target={l.key === 'contact_email' ? undefined : '_blank'}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d={l.icon} /></svg>
          <span>{l.label}</span>
        </a>
      </li>
    ))}
  </ul>
) : (
  <p class="ph-badge">{t(lang, 'placeholder')}: Instagram · TikTok · Email</p>
)}
<style>
  .social { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 0; }
  .social a {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px;
    border-radius: 999px; text-decoration: none; font-weight: 600; border: 1px solid var(--line); color: var(--ink);
  }
  .social a:hover { border-color: var(--ink); }
  .social.dark a { color: #fff; border-color: rgb(255 255 255 / 0.35); }
  .social.dark a:hover { border-color: #fff; }
</style>
