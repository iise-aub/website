---
import Admin from '../../../layouts/Admin.astro';
import { db } from '../../../lib/db';

type Ev = { id: number; slug: string; title_en: string; starts_at: string; ends_at: string; status: string; is_placeholder: number; show_on_history_map: number };
const { results } = await db().prepare('SELECT id, slug, title_en, starts_at, ends_at, status, is_placeholder, show_on_history_map FROM events ORDER BY starts_at DESC').all<Ev>();
const nowMs = Date.now();
const upcoming = results.filter((e) => new Date(e.ends_at).getTime() > nowMs).reverse();
const past = results.filter((e) => new Date(e.ends_at).getTime() <= nowMs);
const when = (iso: string) => new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Beirut', weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(iso));
---
<Admin title="Events" active="events">
  <div class="page-head">
    <div>
      <h1>Events</h1>
      <p>The next published event appears in the homepage banner automatically. Times are Beirut time.</p>
    </div>
    <a class="btn btn-primary" href="/admin/events/new">+ New event</a>
  </div>

  {[{ title: 'Upcoming', items: upcoming, empty: 'No upcoming events. The homepage banner shows your social links instead.' },
    { title: 'Past', items: past, empty: 'No past events yet.' }].map((group) => (
    <section class="card">
      <h2>{group.title}</h2>
      {group.items.length === 0 ? <p class="empty">{group.empty}</p> : (
        <ul class="list">
          {group.items.map((e) => (
            <li>
              <div class="list-main">
                <a class="list-title" href={`/admin/events/${e.id}`}>{e.title_en || '(untitled)'}</a>
                <span class="list-meta">{when(e.starts_at)}</span>
              </div>
              {e.status === 'published' ? <span class="badge badge-ok">Published</span> : <span class="badge badge-draft">Draft (hidden)</span>}
              {e.is_placeholder ? <span class="badge badge-warn">Sample</span> : null}
              {e.show_on_history_map ? <span class="badge badge-draft">On history map</span> : null}
              <a class="icon-btn" href={`/admin/events/${e.id}`}>Edit</a>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
</Admin>
