---
import Admin from '../../../layouts/Admin.astro';
import { db } from '../../../lib/db';
import { logChange } from '../../../lib/admin';

type M = { id: number; title_en: string; year: number; month: number | null; day: number | null; category: string; visible: number; on_home: number; is_placeholder: number; source_note: string; sort_order: number; photos: number };
const d = db();
const by = Astro.locals.user!.email;
const list = async () => (await d.prepare(`SELECT m.*, (SELECT COUNT(*) FROM milestone_photos p WHERE p.milestone_id = m.id) AS photos
  FROM milestones m ORDER BY year, COALESCE(month, 0), COALESCE(day, 0), sort_order, id`).all<M>()).results;
let items = await list();
const sameDate = (a: M, b: M) => a.year === b.year && (a.month ?? 0) === (b.month ?? 0) && (a.day ?? 0) === (b.day ?? 0);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id'));
  const action = String(form.get('_action'));
  const i = items.findIndex((m) => m.id === id);
  if (i >= 0) {
    const m = items[i];
    if (action === 'toggle') {
      await d.batch([d.prepare('UPDATE milestones SET visible = 1 - visible WHERE id = ?').bind(id),
        logChange(by, 'milestones', id, 'update', `${m.visible ? 'Hid' : 'Showed'} “${m.title_en}”`)]);
      return Astro.redirect('/admin/history?saved=' + encodeURIComponent(m.visible ? 'Station hidden' : 'Station visible again'), 303);
    }
    if (action === 'up' || action === 'down') {
      const j = action === 'up' ? i - 1 : i + 1;
      const other = items[j];
      if (other && sameDate(m, other)) {
        // Re-number this date's stations so the swap is always clean.
        const group = items.filter((x) => sameDate(x, m));
        const a = group.indexOf(m), b = group.indexOf(other);
        [group[a], group[b]] = [group[b], group[a]];
        await d.batch([...group.map((x, k) => d.prepare('UPDATE milestones SET sort_order = ? WHERE id = ?').bind(k + 1, x.id)),
          logChange(by, 'milestones', id, 'update', `Reordered “${m.title_en}”`)]);
      }
      return Astro.redirect('/admin/history?saved=' + encodeURIComponent('Order updated'), 303);
    }
  }
  items = await list();
}
const catLabel: Record<string, string> = { ie_world: 'IE worldwide', aub: 'AUB', chapter: 'Chapter', award: 'Award' };
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const dateText = (m: M) => m.is_placeholder ? 'Date not confirmed' : [m.day, m.month ? months[m.month - 1] : null, m.year].filter(Boolean).join(' ');
const shown = items.filter((m) => m.visible);
const onHome = shown.filter((m) => m.on_home).length;
---
<Admin title="History map" active="history">
  <div class="page-head">
    <div>
      <h1>History map</h1>
      <p>Each station on the journey map. Stations are ordered by date automatically; use the arrows only for stations with the same date. Events ticked “Show on history map” also appear on the History page.</p>
      <p><strong>{onHome}</strong> on the homepage (aim for about 8) · <strong>{shown.length}</strong> on the History page (aim for under 15).</p>
    </div>
    <a class="btn btn-primary" href="/admin/history/new">+ New station</a>
  </div>
  <section class="card">
    {items.length === 0 ? <p class="empty">No stations yet.</p> : (
      <ul class="list">
        {items.map((m, i) => {
          const canUp = i > 0 && sameDate(m, items[i - 1]);
          const canDown = i < items.length - 1 && sameDate(m, items[i + 1]);
          return (
            <li>
              <div class="list-main">
                <a class="list-title" href={`/admin/history/${m.id}`}>{m.title_en || '(untitled)'}</a>
                <span class="list-meta">{dateText(m)} · {catLabel[m.category]} · {m.photos ? `${m.photos} photo` : 'no photo'}</span>
              </div>
              {m.is_placeholder ? <span class="badge badge-warn">Not confirmed</span> : !m.source_note.trim() ? <span class="badge badge-warn">No source</span> : <span class="badge badge-ok">Confirmed</span>}
              {!m.visible ? <span class="badge badge-off">Hidden</span> : m.on_home ? <span class="badge badge-ok">Homepage</span> : null}
              <form method="post" class="list-actions">
                <input type="hidden" name="id" value={m.id} />
                <button class="icon-btn" name="_action" value="up" disabled={!canUp} aria-label={`Move “${m.title_en}” earlier`} title="Move earlier (same date only)">↑</button>
                <button class="icon-btn" name="_action" value="down" disabled={!canDown} aria-label={`Move “${m.title_en}” later`} title="Move later (same date only)">↓</button>
                <button class="icon-btn" name="_action" value="toggle">{m.visible ? 'Hide' : 'Show'}</button>
                <a class="icon-btn" href={`/admin/history/${m.id}`}>Edit</a>
              </form>
            </li>
          );
        })}
      </ul>
    )}
  </section>
</Admin>
