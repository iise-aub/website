---
// The full-page journey map: every station (the homepage shows only the main ones).
import Base from '../../layouts/Base.astro';
import JourneyMap from '../../components/JourneyMap.astro';
import { isLang, pick } from '../../lib/i18n';
import { loadHome, loadPage } from '../../lib/db';

const { lang } = Astro.params;
if (!isLang(lang)) return Astro.rewrite('/404');
const [{ stations }, { settings, text }] = await Promise.all([loadHome(lang, true), loadPage('history')]);
const tx = (block: string) => pick(text[block], 'text', lang);
---
<Base lang={lang} title={tx('title').text} description={tx('intro').text} settings={settings}>
  <JourneyMap lang={lang} stations={stations} eyebrow={tx('eyebrow')} title={tx('title')} intro={tx('intro')} headingLevel="h1" />
</Base>
