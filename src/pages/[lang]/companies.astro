---
// Door 3: companies. Why work with us, what we offer, and how to reach us. (No sponsor list: removed by Saad, Oct 22 2026.)
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import TextSection from '../../components/TextSection.astro';
import { isLang, pick, t } from '../../lib/i18n';
import { loadPage } from '../../lib/db';

const { lang } = Astro.params;
if (!isLang(lang)) return Astro.rewrite('/404');
const { settings, text } = await loadPage('companies');
const tx = (block: string) => pick(text[block], 'text', lang);
const ph = (block: string) => Boolean(text[block]?.needs_content);
const arrow = lang === 'ar' ? '←' : '→';
---
<Base lang={lang} title={tx('title').text} description={tx('intro').text} settings={settings}>
  <PageHead lang={lang} eyebrow={tx('eyebrow')} title={tx('title')} intro={tx('intro')}>
    {settings.contact_email && <a class="btn btn-primary" href={`mailto:${settings.contact_email}`}>{t(lang, 'emailUs')} <span class="arrow" aria-hidden="true">{arrow}</span></a>}
  </PageHead>
  <TextSection lang={lang} title={tx('why_title')} body={tx('why_body')} placeholder={ph('why_body')} id="why" />
  <TextSection lang={lang} title={tx('offer_title')} body={tx('offer_body')} placeholder={ph('offer_body')} tone="tint" id="offer" />
  <TextSection lang={lang} title={tx('contact_title')} body={tx('contact_text')} tone="navy" id="contact">
    {settings.contact_email
      ? <a class="btn btn-light" href={`mailto:${settings.contact_email}`}>{settings.contact_email}</a>
      : <span class="ph-badge">{t(lang, 'linkComing')}</span>}
  </TextSection>
</Base>
