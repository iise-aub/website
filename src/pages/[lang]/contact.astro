---
// Contact: Instagram, TikTok, email, WhatsApp (behind the robot check), LinkedIn if set. No contact form (brief).
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import PageHead from '../../components/PageHead.astro';
import WhatsAppReveal from '../../components/WhatsAppReveal.astro';
import { isLang, pick, t } from '../../lib/i18n';
import { loadPage } from '../../lib/db';

const { lang } = Astro.params;
if (!isLang(lang)) return Astro.rewrite('/404');
const { settings, text } = await loadPage('contact');
const tx = (block: string) => pick(text[block], 'text', lang);
const arrow = lang === 'ar' ? '←' : '→';
const handle = (url: string) => url.replace(/^https?:\/\/(www\.)?[^/]+\/?/, '').replace(/\/$/, '');
const channels = [
  { key: 'instagram_url', label: 'Instagram', detail: (u: string) => '@' + handle(u).replace(/^@/, ''), icon: 'M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5Zm5.25-3a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z' },
  { key: 'tiktok_url', label: 'TikTok', detail: (u: string) => handle(u), icon: 'M16.6 2c.3 2.4 1.7 4 4.1 4.2v3.1a7.6 7.6 0 0 1-4-1.2v6.6c0 4.3-3.5 6.8-7 6.3-3.5-.5-5.6-3.6-5-7 .6-3.2 3.6-5 6.9-4.6v3.3c-1.6-.4-3.4.4-3.7 2-.3 1.5.7 2.9 2.2 3.1 1.6.2 3.3-.8 3.3-3V2h3.2Z' },
  { key: 'contact_email', label: 'Email', detail: (u: string) => u, href: (u: string) => `mailto:${u}`, icon: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V17h16V7.4l-8 5.3-8-5.3ZM5.6 7 12 11.2 18.4 7H5.6Z' },
  { key: 'linkedin_url', label: 'LinkedIn', detail: () => 'IISE AUB', icon: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.8v1.6h.06c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.6 4.77 6V21h-4v-5c0-1.2 0-2.75-1.7-2.75-1.7 0-1.95 1.3-1.95 2.66V21h-4V9.75Z' },
].filter((c) => settings[c.key]);
---
<Base lang={lang} title={tx('title').text} description={tx('intro').text} settings={settings}>
  <PageHead lang={lang} eyebrow={tx('eyebrow')} title={tx('title')} intro={tx('intro')} />

  <section class="wrap block" aria-label={tx('title').text}>
    <ul class="channels">
      {channels.map((c) => {
        const value = settings[c.key];
        return (
          <li>
            <a class="channel" href={c.href ? c.href(value) : value} target={c.href ? undefined : '_blank'} rel="noopener">
              <span class="ch-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d={c.icon} /></svg></span>
              <span class="ch-text"><span class="ch-label">{c.label}</span><span class="ch-detail" dir="ltr">{c.detail(value)}</span></span>
              <span class="ch-go" aria-hidden="true">{arrow}</span>
            </a>
          </li>
        );
      })}
      <li class="channel wa-card">
        <span class="ch-icon wa" aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/></svg></span>
        <span class="ch-text"><span class="ch-label">WhatsApp</span><WhatsAppReveal lang={lang} available={Boolean(settings.whatsapp_url)} /></span>
      </li>
    </ul>
    <p class="partners"><T v={tx('partners_text')} page={lang} /> <a href={`/${lang}/companies`}>{t(lang, 'seePartnering')} <span aria-hidden="true">{arrow}</span></a></p>
  </section>
</Base>
<style>
  .block { padding-block: 28px; }
  .channels { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .channel {
    display: flex; align-items: center; gap: 16px; padding: 18px 20px; min-height: 88px;
    background: var(--white); border: 1px solid var(--steel-200); border-radius: var(--radius); color: var(--navy-900); text-decoration: none;
    transition: border-color 200ms ease, box-shadow 300ms var(--ease-out);
  }
  a.channel:hover { border-color: var(--navy-800); box-shadow: var(--shadow); color: var(--navy-900); }
  .ch-icon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: var(--steel-100); color: var(--navy-800); flex: none; }
  .ch-icon.wa { background: #e3f4ea; color: #0f7a40; }
  .ch-text { display: grid; gap: 4px; flex: 1; min-width: 0; }
  .ch-label { font-weight: 700; font-size: 1.1rem; }
  .ch-detail { color: var(--ink-soft); overflow-wrap: anywhere; text-align: start; }
  .ch-go { color: var(--navy-800); font-weight: 700; }
  .wa-card { align-items: flex-start; }
  .partners { margin-top: 28px; color: var(--ink-soft); }
  .partners a { font-weight: 600; }
</style>
