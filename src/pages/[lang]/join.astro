---
// Join page: AUB's registration link, the current CRN with a copy button and its term, and the steps.
// Everything comes from the panel (settings + page text "join").
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import LogoGlobe from '../../components/LogoGlobe.astro';
import { isLang, pick, t } from '../../lib/i18n';
import { loadPage } from '../../lib/db';

const { lang } = Astro.params;
if (!isLang(lang)) return Astro.rewrite('/404');

const { settings, text } = await loadPage('join');
const tx = (block: string) => pick(text[block], 'text', lang);
const ph = (block: string) => Boolean(text[block]?.needs_content);
const term = pick({ term_en: settings.crn_term_en, term_ar: settings.crn_term_ar }, 'term', lang);
const stepsText = tx('steps');
const steps = stepsText.text.split('\n').map((s) => s.trim()).filter(Boolean);
// Quoted button and menu names (e.g. "Register for Classes", «Submit») are kept whole and left-to-right,
// so they read correctly inside Arabic sentences and never wrap mid-name.
const stepParts = (step: string) => step.split(/(«[^»]*»|"[^"]*")/).filter(Boolean).map((part) => {
  const m = part.match(/^([«"])([^»"]*)([»"])$/);
  if (!m) return { text: part };
  const name = m[2].replace(/[⁦-⁩]/g, '');
  return { open: m[1], name, close: m[3], latin: /[A-Za-z]/.test(name) };
});
const aubUrl = settings.aub_registration_url;
const guideUrl = settings.registration_guide_url;
---
<Base lang={lang} title={tx('eyebrow').text || t(lang, 'nav_join')} description={tx('intro').text} settings={settings}>
  <section class="join wrap">
    <div class="join-head">
      <T v={tx('eyebrow')} page={lang} as="p" class="eyebrow" />
      <h1><T v={tx('title')} page={lang} placeholder={ph('title')} /></h1>
      <T v={tx('intro')} page={lang} as="p" class="lede" placeholder={ph('intro')} />
    </div>

    <div class="join-grid">
      <!-- The CRN -->
      <div class="crn-panel">
        <div class="crn-globe" aria-hidden="true"><LogoGlobe /></div>
        <p class="crn-label">{t(lang, 'crnToEnter')}</p>
        <p class="crn-num" dir="ltr">{settings.crn || '—'}</p>
        {term.text && <p class="crn-term"><T v={term} page={lang} /></p>}
        {settings.crn && (
          <button type="button" class="btn btn-ghost copy-btn" data-copy={settings.crn} data-copied={t(lang, 'copied')} aria-label={t(lang, 'copyCrn')}>
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 3h11a2 2 0 0 1 2 2v11h-2V5H8V3Zm-3 4h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Zm0 2v10h10V9H5Z"/></svg>
            <span data-copy-label>{t(lang, 'copy')}</span>
          </button>
        )}
        <p class="visually-hidden" aria-live="polite" data-copy-status></p>
      </div>

      <!-- The steps -->
      <div class="steps-panel">
        <h2 class="steps-title">{t(lang, 'stepsTitle')} {ph('steps') && <span class="ph-badge">{t(lang, 'placeholder')}</span>}</h2>
        <ol class="steps" lang={stepsText.lang !== lang ? stepsText.lang : undefined} dir={stepsText.lang !== lang ? 'ltr' : undefined}>
          {steps.map((s) => (
            <li><span>{stepParts(s).map((p) => p.text !== undefined ? p.text : <>{p.open}<bdi class:list={['ui-name', { latin: p.latin }]}>{p.name}</bdi>{p.close}</>)}</span></li>
          ))}
        </ol>
        {aubUrl ? (
          <a class="btn btn-primary btn-lg go" href={aubUrl} target="_blank" rel="noopener">
            {t(lang, 'goToAub')}
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M14 3h7v7h-2V6.4l-8.3 8.3-1.4-1.4L17.6 5H14V3ZM5 5h6v2H5v12h12v-6h2v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z"/></svg>
            <span class="visually-hidden">{t(lang, 'newTab')}</span>
          </a>
        ) : (
          <p class="ph-badge">{t(lang, 'linkComing')}</p>
        )}
        {guideUrl && (
          <p class="guide">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M6 2h8l6 6v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm7 1.5V9h5.5L13 3.5ZM8 13v2h8v-2H8Zm0 4v2h5v-2H8Z"/></svg>
            <span>{t(lang, 'regGuideLead')} <a href={guideUrl} target="_blank" rel="noopener">{t(lang, 'regGuide')}<span class="visually-hidden"> {t(lang, 'newTab')}</span></a></span>
          </p>
        )}
      </div>
    </div>
  </section>
</Base>

<script>
  // Copy the CRN, with a short confirmation for sighted and screen-reader users.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-copy-label]')!;
    const status = btn.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    const original = label.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
      } catch {
        const tmp = Object.assign(document.createElement('textarea'), { value: btn.dataset.copy! });
        document.body.appendChild(tmp); tmp.select(); document.execCommand('copy'); tmp.remove();
      }
      label.textContent = btn.dataset.copied!;
      if (status) status.textContent = btn.dataset.copied!;
      btn.classList.add('is-copied');
      setTimeout(() => { label.textContent = original; btn.classList.remove('is-copied'); }, 1800);
    });
  });
</script>

<style>
  .join { padding-block: 48px 0; }
  .join-head { max-width: 720px; }
  .join h1 { font-size: clamp(2.3rem, 6vw, 3.8rem); }
  .lede { font-size: 1.2rem; color: var(--ink-soft); max-width: 52ch; }
  .join-grid { display: grid; gap: 20px; margin-top: 36px; }
  @media (min-width: 880px) { .join-grid { grid-template-columns: 0.9fr 1.1fr; gap: 28px; align-items: stretch; } }

  .crn-panel {
    position: relative; overflow: hidden; isolation: isolate; padding: 28px; border-radius: calc(var(--radius) + 4px);
    background: var(--steel-50); border: 1px solid var(--steel-200);
    display: grid; align-content: start; justify-items: start; gap: 4px;
  }
  .crn-globe { position: absolute; width: 300px; inset-inline-end: -90px; bottom: -70px; opacity: 0.16; z-index: -1; }
  .crn-label { margin: 0; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--grey-600); }
  :lang(ar) .crn-label { letter-spacing: 0; text-transform: none; font-size: 1rem; }
  .crn-num { margin: 0; font-weight: 800; font-size: clamp(4rem, 16vw, 6rem); line-height: 1; color: var(--navy-800); letter-spacing: 0.02em; font-variant-numeric: tabular-nums; font-family: var(--font-latin); }
  .crn-term { margin: 0 0 16px; color: var(--ink-soft); }
  .copy-btn { min-height: 46px; }
  .is-copied { background: #dcfce7; border-color: #86efac; color: #14532d; }

  .steps-panel { padding: 28px; border-radius: calc(var(--radius) + 4px); border: 1px solid var(--steel-200); background: var(--white); box-shadow: var(--shadow); }
  .steps-title { font-size: 1.6rem; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .steps { list-style: none; counter-reset: step; margin: 0 0 24px; padding: 0; display: grid; gap: 14px; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 36px 1fr; gap: 14px; align-items: start; }
  .steps li::before {
    content: counter(step); display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%;
    background: var(--navy-800); color: #fff; font-weight: 700;
  }
  .ui-name { font-weight: 600; color: var(--navy-900); }
  .ui-name.latin { white-space: nowrap; font-family: var(--font-latin); }
  .go { width: 100%; }
  .guide { display: flex; align-items: flex-start; gap: 8px; margin: 16px 0 0; font-size: 0.95rem; color: var(--ink-soft); }
  .guide svg { flex: none; margin-top: 3px; color: var(--steel-400); }
  .guide a { color: var(--navy-800); font-weight: 600; text-underline-offset: 3px; }
  @media (min-width: 520px) { .go { width: auto; } }
  .btn-lg { min-height: 54px; padding-inline: 1.6em; }
</style>
